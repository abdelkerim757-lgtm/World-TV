<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>World TV 📺</title>

<style>
body{
    margin:0;
    background:#101318;
    color:white;
    font-family:Arial,Tahoma,sans-serif;
}

header{
    background:#181c24;
    padding:20px 15px;
    text-align:center;
}

h1{
    margin:0;
    font-size:28px;
}

.subtitle{
    color:#aaa;
    margin-top:8px;
}

.controls{
    display:flex;
    gap:8px;
    margin:18px auto 0;
    max-width:700px;
}

input,select{
    background:#252a34;
    color:white;
    border:1px solid #3b4350;
    border-radius:10px;
    padding:12px;
    font-size:15px;
}

input{
    flex:1;
}

main{
    max-width:1100px;
    margin:auto;
    padding:15px;
}

.status{
    text-align:center;
    color:#aaa;
    padding:15px;
}

.country{
    margin-top:30px;
    border-right:4px solid #287cf0;
    padding-right:10px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(190px,1fr));
    gap:12px;
}

.card{
    background:#191e27;
    border:1px solid #2d333e;
    border-radius:14px;
    padding:13px;
}

.logo{
    width:60px;
    height:60px;
    object-fit:contain;
    background:white;
    border-radius:10px;
}

.name{
    font-weight:bold;
    margin-top:10px;
}

.info{
    color:#929aa7;
    font-size:12px;
    margin-top:5px;
}

button{
    width:100%;
    margin-top:12px;
    padding:10px;
    border:0;
    border-radius:9px;
    background:#287cf0;
    color:white;
    font-weight:bold;
}
</style>
</head>

<body>

<header>

<h1>🌍 World TV 📺</h1>

<div class="subtitle">
قنوات عالمية مرتبة حسب الدولة
</div>

<div class="controls">

<input
id="search"
placeholder="🔎 ابحث عن قناة..."
>

<select id="country">
<option value="">🌍 كل الدول</option>
</select>

</div>

</header>

<main>

<div id="status" class="status">
جاري تحميل القنوات...
</div>

<div id="list"></div>

</main>

<script>

const API =
"https://iptv-org.github.io/api/";

let channels=[];
let streams=[];
let streamMap=new Map();


async function load(){

try{

const c =
await fetch(
API+"channels.json"
).then(r=>r.json());

const s =
await fetch(
API+"streams.json"
).then(r=>r.json());

channels=c;
streams=s;

streams.forEach(x=>{

if(x.channel && x.url){

streamMap.set(
x.channel,
x.url
);

}

});

createCountries();

display();

}catch(e){

document.getElementById(
"status"
).textContent=
"❌ تعذر تحميل القنوات";

}

}


function createCountries(){

const select=
document.getElementById(
"country"
);

const countries=new Set();

channels.forEach(c=>{

if(c.countries){

c.countries.forEach(
x=>countries.add(x)
);

}

});

Array.from(countries)
.sort()
.forEach(x=>{

const option=
document.createElement(
"option"
);

option.value=x;
option.textContent=x;

select.appendChild(option);

});

}


function display(){

const search=
document.getElementById(
"search"
).value
.toLowerCase();

const selected=
document.getElementById(
"country"
).value;

const groups={};

channels.forEach(c=>{

const url=
streamMap.get(c.id);

if(!url)return;

const matchSearch=
!search ||
(c.name||"")
.toLowerCase()
.includes(search);

const matchCountry=
!selected ||
(c.countries||[])
.includes(selected);

if(
matchSearch &&
matchCountry
){

const country=
c.countries &&
c.countries.length
?c.countries[0]
:"International";

if(!groups[country])
groups[country]=[];

groups[country].push({
channel:c,
url:url
});

}

});


const list=
document.getElementById(
"list"
);

let html="";

Object.keys(groups)
.sort()
.forEach(country=>{

html+=
`<h2 class="country">
🌐 ${escapeHTML(country)}
</h2>`;

html+=
`<div class="grid">`;

groups[country]
.sort((a,b)=>
a.channel.name
.localeCompare(
b.channel.name
))
.forEach(item=>{

const c=
item.channel;

html+=`

<div class="card">

${
c.logo
?
`<img
class="logo"
src="${c.logo}"
onerror="this.style.display='none'"
>`
:""
}

<div class="name">
${escapeHTML(c.name)}
</div>

<div class="info">
${
(c.languages||[])
.join(", ")
}
</div>

<button
onclick="watch('${escapeJS(item.url)}')"
>
▶ مشاهدة
</button>

</div>

`;

});

html+="</div>";

});


if(!html){

html=
"<div class='status'>لا توجد قنوات.</div>";

}

list.innerHTML=html;

document.getElementById(
"status"
).textContent=
"القنوات المتاحة: "+
document.querySelectorAll(
".card"
).length;

}


function watch(url){

window.open(
url,
"_blank"
);

}


function escapeHTML(text){

return String(text||"")
.replace(
/[&<>"']/g,
m=>({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"
}[m])
);

}


function escapeJS(text){

return String(text||"")
.replace(/\\/g,"\\\\")
.replace(/'/g,"\\'");

}


document
.getElementById("search")
.addEventListener(
"input",
display
);

document
.getElementById("country")
.addEventListener(
"change",
display
);


load();

</script>

</body>
</html>
